{
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (xelatex)",
            "tools": [
                "latexmk-xelatex"
            ]
        },
        {
            "name": "xelatex -> biber -> xelatex x2",
            "tools": [
                "xelatex",
                "biber",
                "xelatex",
                "xelatex"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-xelatex",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "%DOC%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bcf",
        "*.bbl",
        "*.blg",
        "*.lof",
        "*.lot",
        "*.log",
        "*.out",
        "*.run.xml",
        "*.synctex.gz",
        "*.toc",
        "*.fdb_latexmk",
        "*.fls",
        "*.idx",
        "*.ind",
        "*.ilg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.xdv",
        "*.equ",
        "*.loa",
        "*.apx"
    ],
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.view.pdf.viewer": "tab"
}
